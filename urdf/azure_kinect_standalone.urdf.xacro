 Standalone robot-description of a Microsoft Azure Kinect camera on the included stand.
 -->

<robot name="azure_kinect" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="publish_calibrated_poses" default="true"/>

  <link name="azure_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://azure_kinect_ros_driver/meshes/azure_mount.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://azure_kinect_ros_driver/meshes/azure_mount.stl"/>
      </geometry>
    </collision>
  </link>

    <joint name="mounting_plate-azure_mount" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <parent link="mounting_plate" />
      <child link="azure_mount" />
    </joint>

    

  <xacro:include filename="$(find azure_kinect_ros_driver)/urdf/azure_kinect_macro.urdf.xacro" />

  <xacro:azure_kinect prefix="$(arg tf_prefix)" parent="azure_mount" gazebo="false" publish_calibrated_poses="$(arg publish_calibrated_poses)">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:azure_kinect>


</robot>
